# WhatsApp Business Cloud API Configuration
# Get these credentials from your Meta for Developers dashboard:
# https://developers.facebook.com/apps/ -> WhatsApp -> API Setup

# 1. Permanent System User Access Token (recommended for production) or Temporary Access Token (24h test)
WHATSAPP_API_TOKEN=your_meta_system_user_access_token_here

# 2. WhatsApp Phone Number ID (Found in WhatsApp > API Setup > Step 1)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# 3. WhatsApp Business Account ID (Found in WhatsApp > API Setup)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# 4. Meta Graph API Version (defaults to v20.0)
WHATSAPP_CLOUD_API_VERSION=v20.0

